#!/bin/sh
# Runs cli/main.ts of this repository, wherever a link to this file lives.
set -eu

self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
root=$(cd "$(dirname "$self")/.." && pwd -P)
exec bun "$root/cli/main.ts" "$@"
